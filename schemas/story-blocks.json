{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memoloupe.local/schemas/story-blocks.json",
  "title": "MemoLoupe story-blocks.json",
  "type": "object",
  "additionalProperties": true,
  "required": ["status", "boundarySource", "gapMs", "generatedAt", "blocks", "slots"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["complete", "scaffold"]
    },
    "boundarySource": {
      "type": "string",
      "enum": ["model", "asr-gap"]
    },
    "gapMs": { "type": "integer", "minimum": 0 },
    "generatedAt": { "type": "string" },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "storyBlockID",
          "shotIDs",
          "startMs",
          "endMs",
          "boundary",
          "divisionAxis",
          "divisionRationale",
          "primaryRole",
          "coreContent",
          "informationRole",
          "narrativeDensity",
          "audienceReaction",
          "visualIndependence",
          "blockRelation",
          "relationReason"
        ],
        "properties": {
          "storyBlockID": {
            "type": "string",
            "pattern": "^B\\d{4}$"
          },
          "shotIDs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^SH\\d{4}$"
            }
          },
          "startMs": { "type": "integer", "minimum": 0 },
          "endMs": { "type": "integer", "minimum": 0 },
          "boundaryBasis": { "type": "string" },
          "boundary": {
            "type": "object",
            "additionalProperties": true,
            "required": ["level", "signal", "label"],
            "properties": {
              "level": { "type": "string" },
              "signal": { "type": "string" },
              "label": { "type": "string" }
            }
          },
          "blockTitle": { "type": "string" },
          "divisionAxis": {
            "type": "string",
            "enum": [
              "主题/话题",
              "行动/任务",
              "场景/时空",
              "情绪/语气",
              "人物/主体",
              "unknown"
            ]
          },
          "divisionRationale": { "type": "string" },
          "primaryRole": {
            "type": "string",
            "enum": [
              "hook",
              "context",
              "promise",
              "problem",
              "development",
              "proof",
              "turn",
              "payoff",
              "resolution",
              "custom",
              "unknown"
            ]
          },
          "coreContent": { "type": "string" },
          "informationRole": {
            "type": "string",
            "pattern": "^(建立背景|推进新信息|解释原因|演示步骤|得出结论|重复强调|转移话题)(、(建立背景|推进新信息|解释原因|演示步骤|得出结论|重复强调|转移话题))*$"
          },
          "narrativeDensity": {
            "type": "string",
            "enum": ["高", "中", "低", "unknown"]
          },
          "audienceReaction": {
            "type": "string",
            "enum": [
              "好奇/想看下去",
              "共鸣/代入",
              "意外/反转",
              "娱乐/好笑",
              "获得信息/学到东西",
              "建立信任/认同",
              "无强烈反应（信息过场）",
              "unknown"
            ]
          },
          "visualIndependence": {
            "type": "string",
            "enum": [
              "静音也能看懂",
              "需要声音辅助",
              "没有声音完全看不懂",
              "unknown"
            ]
          },
          "blockRelation": { "type": "string" },
          "relationReason": { "type": "string" }
        }
      }
    },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "slotID",
          "slotType",
          "slotTitle",
          "blockIDs",
          "slotRationale"
        ],
        "properties": {
          "slotID": {
            "type": "string",
            "pattern": "^S\\d{3}$"
          },
          "slotType": {
            "type": "string",
            "pattern": "^(开场引入|背景铺垫|行动展开|冲突转折|深度剖析|高潮兑现|总结升华|结尾收束|custom)(、(开场引入|背景铺垫|行动展开|冲突转折|深度剖析|高潮兑现|总结升华|结尾收束|custom))*$"
          },
          "slotTitle": { "type": "string" },
          "blockIDs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^B\\d{4}$"
            }
          },
          "slotRationale": { "type": "string" }
        }
      }
    }
  }
}
