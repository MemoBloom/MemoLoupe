{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memoloupe.local/schemas/unified-media.json",
  "title": "MemoLoupe unified-media.json",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "service",
    "schemaFingerprint",
    "request",
    "retryPolicy",
    "clips",
    "batches",
    "shotStatuses",
    "status"
  ],
  "$defs": {
    "shotID": {
      "type": "string",
      "pattern": "^SH\\d{4}$"
    },
    "modelShot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shotID",
        "visual",
        "function",
        "audio",
        "components",
        "confidence"
      ],
      "properties": {
        "shotID": { "$ref": "#/$defs/shotID" },
        "visual": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "subjects",
            "actions",
            "setting",
            "props",
            "framing",
            "cameraAngle",
            "composition",
            "viewpoint",
            "perceivedLensFeel",
            "cameraMovement",
            "brightness",
            "contrast",
            "lightingSource",
            "perceivedColorTemperature",
            "dominantColor",
            "saturation",
            "depthOfField",
            "imageTexture"
          ],
          "properties": {
            "subjects": { "type": "string" },
            "actions": { "type": "string" },
            "setting": { "type": "string" },
            "props": { "type": "string" },
            "framing": { "type": "string" },
            "cameraAngle": { "type": "string" },
            "composition": { "type": "string" },
            "viewpoint": { "type": "string" },
            "perceivedLensFeel": { "type": "string" },
            "cameraMovement": { "type": "string" },
            "brightness": { "type": "string" },
            "contrast": { "type": "string" },
            "lightingSource": { "type": "string" },
            "perceivedColorTemperature": { "type": "string" },
            "dominantColor": { "type": "string" },
            "saturation": { "type": "string" },
            "depthOfField": { "type": "string" },
            "imageTexture": { "type": "string" }
          }
        },
        "function": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceMedium", "subjectEmotion", "shotTone"],
          "properties": {
            "sourceMedium": { "type": "string" },
            "subjectEmotion": { "type": "string" },
            "shotTone": { "type": "string" }
          }
        },
        "audio": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bgmStyle", "soundEvents"],
          "properties": {
            "bgmStyle": { "type": "string" },
            "soundEvents": { "type": "string" }
          }
        },
        "components": {
          "type": "object",
          "additionalProperties": false,
          "required": ["texts", "nonTextOverlayEvents"],
          "properties": {
            "texts": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "textContent",
                  "textType",
                  "textStyle",
                  "textAnimation"
                ],
                "properties": {
                  "textContent": { "type": "string" },
                  "textType": { "type": "string" },
                  "textStyle": { "type": "string" },
                  "textAnimation": { "type": "string" }
                }
              }
            },
            "nonTextOverlayEvents": { "type": "string" }
          }
        },
        "confidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["visual", "audio", "function"],
          "properties": {
            "visual": {
              "type": "string",
              "enum": ["high", "medium", "low", "unknown"]
            },
            "audio": {
              "type": "string",
              "enum": ["high", "medium", "low", "unknown"]
            },
            "function": {
              "type": "string",
              "enum": ["high", "medium", "low", "unknown"]
            }
          }
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  },
  "properties": {
    "schemaVersion": { "const": 3 },
    "service": { "const": "unifiedAudioVideo" },
    "schemaFingerprint": { "type": "string" },
    "request": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "model",
        "clipTransport",
        "batchSize",
        "concurrency",
        "externalFrameExtraction",
        "videoFPS",
        "mediaResolution",
        "sourceRevisionID",
        "shortClipPolicy"
      ],
      "properties": {
        "model": { "type": "string" },
        "fallbackModel": { "type": ["string", "null"] },
        "clipTransport": { "const": "mediaDataURI" },
        "batchSize": { "type": "integer", "minimum": 1 },
        "concurrency": { "type": "integer", "minimum": 1 },
        "externalFrameExtraction": { "const": false },
        "videoFPS": { "type": "number" },
        "mediaResolution": {
          "type": "string",
          "enum": ["default", "low", "high"]
        },
        "sourceRevisionID": { "type": ["string", "null"] },
        "shortClipPolicy": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "minimumDurationMs",
            "imageProxyWidth"
          ],
          "properties": {
            "minimumDurationMs": { "type": "integer", "minimum": 0 },
            "imageProxyWidth": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "retryPolicy": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "maxRetries",
        "fallbackFromBatchToSingleShot",
        "checkpointAfterEachRequest"
      ],
      "properties": {
        "maxRetries": { "type": "integer", "minimum": 0 },
        "fallbackFromBatchToSingleShot": { "type": "boolean" },
        "checkpointAfterEachRequest": { "type": "boolean" }
      }
    },
    "clips": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "shotID",
          "startMs",
          "endMs",
          "durationMs",
          "file",
          "modelFile",
          "modelDurationMs"
        ],
        "properties": {
          "shotID": { "$ref": "#/$defs/shotID" },
          "startMs": { "type": "integer", "minimum": 0 },
          "endMs": { "type": "integer", "minimum": 0 },
          "durationMs": { "type": "integer", "minimum": 0 },
          "file": { "type": "string" },
          "modelFile": { "type": "string" },
          "modelDurationMs": { "type": "integer", "minimum": 0 },
          "modelNormalization": {
            "type": ["object", "null"],
            "additionalProperties": true
          }
        }
      }
    },
    "batches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["batchID", "shotIDs", "status"],
        "properties": {
          "batchID": {
            "type": "string",
            "pattern": "^B\\d{4}$"
          },
          "shotIDs": {
            "type": "array",
            "items": { "$ref": "#/$defs/shotID" }
          },
          "status": {
            "type": "string",
            "enum": ["complete", "dryRun", "failed"]
          },
          "response": {
            "type": "object",
            "additionalProperties": true,
            "required": ["shots"],
            "properties": {
              "shots": {
                "type": "array",
                "items": { "$ref": "#/$defs/modelShot" }
              }
            }
          }
        }
      }
    },
    "shotStatuses": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": ["succeeded", "pending", "permanent_failure"]
      }
    },
    "completedShots": { "type": "integer", "minimum": 0 },
    "failedShots": { "type": "integer", "minimum": 0 },
    "pendingShots": { "type": "integer", "minimum": 0 },
    "permanentFailureShots": { "type": "integer", "minimum": 0 },
    "terminal": { "type": "boolean" },
    "status": {
      "type": "string",
      "enum": ["complete", "partial", "running", "dryRun", "skipped", "failed"]
    }
  }
}
