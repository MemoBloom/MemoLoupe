# MemoLoupe local service configuration example.
#
# Copy this file to .env and pass `--env-file .env` to any memoloupe command
# (it does NOT overwrite already-set environment variables). Nested config
# keys use double underscores after the MEMOLOUPE_ prefix.

# Story/profile text model: OpenAI-compatible /chat/completions endpoint.
MEMOLOUPE_TEXTMODEL__BASEURL=https://api.example.com/v1
MEMOLOUPE_TEXTMODEL__APIKEY=replace-with-text-model-key
MEMOLOUPE_TEXTMODEL__MODEL=replace-with-text-model-name
MEMOLOUPE_TEXTMODEL__TIMEOUTSEC=300
MEMOLOUPE_TEXTMODEL__MAXTOKENS=0

# Unified audio-video model used by Phase 1 semantic analysis.
# fallbackModel: when the primary model fails, requests are re-sent with this
# model name (05-01B). Leave empty to disable fallback.
MEMOLOUPE_UNIFIEDMODEL__BASEURL=https://api.example.com/v1
MEMOLOUPE_UNIFIEDMODEL__APIKEY=replace-with-unified-model-key
MEMOLOUPE_UNIFIEDMODEL__MODEL=replace-with-unified-model-name
MEMOLOUPE_UNIFIEDMODEL__FALLBACKMODEL=
MEMOLOUPE_UNIFIEDMODEL__BATCHSIZE=4
MEMOLOUPE_UNIFIEDMODEL__CONCURRENCY=10

# ASR service (05-01C). provider selects the transport:
#   openai-json       JSON + base64 body (default)
#   openai-multipart  multipart/form-data file upload (fileField configurable)
MEMOLOUPE_ASR__BASEURL=https://api.example.com/v1
MEMOLOUPE_ASR__APIKEY=replace-with-asr-key
MEMOLOUPE_ASR__MODEL=replace-with-asr-model-name
MEMOLOUPE_ASR__PROVIDER=openai-json
MEMOLOUPE_ASR__FILEFIELD=file
MEMOLOUPE_ASR__ENABLED=true

# Real-service opt-in e2e tests (05-01D): set to 1 and provide credentials to
# run real-network smoke tests; otherwise they are skipped.
# MEMOLOUPE_RUN_REAL_SERVICE_TESTS=1
