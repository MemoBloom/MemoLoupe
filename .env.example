# MemoLoupe local service configuration example.
#
# Copy this file to .env and pass `--env-file .env` to any memoloupe command
# (it does NOT overwrite already-set environment variables). Nested config
# keys use double underscores after the MEMOLOUPE_ prefix.

# Xiaomi MiMo text model used by story/profile analysis.
# BASEURL is the API root; MemoLoupe appends /chat/completions itself.
MEMOLOUPE_TEXTMODEL__BASEURL=https://api.xiaomimimo.com/v1
MEMOLOUPE_TEXTMODEL__APIKEY=replace-with-xiaomi-mimo-api-key
MEMOLOUPE_TEXTMODEL__MODEL=mimo-v2.5
MEMOLOUPE_TEXTMODEL__TIMEOUTSEC=300
MEMOLOUPE_TEXTMODEL__MAXTOKENS=0

# Xiaomi MiMo unified audio-video model used by Phase 1 semantic analysis.
# It currently shares the same endpoint and credential as TextModel.
# fallbackModel: when the primary model fails, requests are re-sent with this
# model name (05-01B). Leave empty to disable fallback.
MEMOLOUPE_UNIFIEDMODEL__BASEURL=https://api.xiaomimimo.com/v1
MEMOLOUPE_UNIFIEDMODEL__APIKEY=replace-with-xiaomi-mimo-api-key
MEMOLOUPE_UNIFIEDMODEL__MODEL=mimo-2.5
MEMOLOUPE_UNIFIEDMODEL__FALLBACKMODEL=
MEMOLOUPE_UNIFIEDMODEL__BATCHSIZE=4
MEMOLOUPE_UNIFIEDMODEL__CONCURRENCY=10

# Local ASR used by the current MemoLoupe pipeline:
# FireRedVAD voice-activity segmentation + MLX Whisper transcription.
# Install first: uv sync --extra asr-local
MEMOLOUPE_ASR__ENABLED=true
MEMOLOUPE_ASR__PROVIDER=local-fireredvad-mlx
MEMOLOUPE_ASR__LANGUAGE=zh
MEMOLOUPE_ASR__WHISPER__MODEL=mlx-community/whisper-large-v3-turbo
MEMOLOUPE_ASR__WHISPER__WORDTIMESTAMPS=true
MEMOLOUPE_ASR__VAD__MODELDIR=
MEMOLOUPE_ASR__VAD__SPEECHTHRESHOLD=0.4
MEMOLOUPE_ASR__VAD__SMOOTHWINDOWSIZE=5
MEMOLOUPE_ASR__VAD__MINSPEECHFRAME=20
MEMOLOUPE_ASR__VAD__MAXSPEECHFRAME=2000
MEMOLOUPE_ASR__VAD__MINSILENCEFRAME=20
MEMOLOUPE_ASR__MERGEGAPMS=300
MEMOLOUPE_ASR__WINDOWSEC=30
MEMOLOUPE_ASR__WINDOWPADMS=200

# Remote ASR alternative. Uncomment these and change PROVIDER to
# openai-json or openai-multipart when using a remote /audio/transcriptions API,
# or mimo-chat for MiMo's chat-completions ASR (mimo-v2.5-asr; when you used
# `memoloupe connect add mimo`, this is configured automatically).
# Or set PROVIDER=auto: use local ASR when its dependencies are installed,
# otherwise fall back to the remote settings below, otherwise degrade
# explicitly with a warning.
# MEMOLOUPE_ASR__BASEURL=https://api.example.com/v1
# MEMOLOUPE_ASR__APIKEY=replace-with-asr-key
# MEMOLOUPE_ASR__MODEL=replace-with-asr-model-name
# MEMOLOUPE_ASR__FILEFIELD=file
# MEMOLOUPE_ASR__TIMEOUTSEC=120

# Real-service opt-in e2e tests (05-01D): set to 1 and provide credentials to
# run real-network smoke tests; otherwise they are skipped.
# MEMOLOUPE_RUN_REAL_SERVICE_TESTS=1
